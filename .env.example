# Copy to .env and fill in. .env is git-ignored.

# LLM provider keys. The discover, tailor, and cover-letter steps default to
# Claude, so ANTHROPIC_API_KEY is all you need out of the box. To use another
# provider, set its key here and prefix the matching model id below with the
# provider name (see CHEAP_MODEL / MID_MODEL / PREMIUM_MODEL).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Optional: override the three model tiers. A bare id is Anthropic; prefix with
# openai: / gemini: / deepseek: to route a tier to another provider. You can mix
# providers across tiers — each tier uses the key of its own provider.
#   CHEAP_MODEL=gemini:gemini-3.5-flash-lite
#   MID_MODEL=deepseek:deepseek-chat
#   PREMIUM_MODEL=claude-opus-5          # bare = Anthropic
# CHEAP_MODEL=
# MID_MODEL=
# PREMIUM_MODEL=

# Anthropic only: cache each agent's static system prompt across repeated calls.
# PROMPT_CACHE_ENABLED=true

# Optional: enriches `profile build` from your GitHub repos.
GITHUB_TOKEN=

# Optional: Adzuna API credentials for the Adzuna connector used by `pull`.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: burner LinkedIn account. `scrape`/`pull` auto-fill these at the
# login form; on a 2FA/captcha checkpoint a (non-headless) window waits for you
# to finish by hand. The session then persists in LINKEDIN_USER_DATA_DIR.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
LINKEDIN_USER_DATA_DIR=.linkedin_profile

# Gmail: CLI-only `sync-status` authenticates via config/gmail_credentials.json
# instead (no key here). The API/web app (and any Railway deploy) needs a
# Google OAuth *Web application* client — create one with redirect URI
# <your-domain>/api/gmail/callback, then set these two. Optional: powers
# sync-status/scheduled sync/reminders/email drafts; skip if you'll track
# statuses by hand.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

DB_URL=sqlite:///data/resume_agent.db

# Public-web hardening. Keep local development defaults false/blank; production
# deployments should set the canonical origin/host and force secure cookies.
APP_BASE_URL=
ALLOWED_HOSTS=
SECURE_COOKIES=false
DISABLE_API_DOCS=false
REGISTRATION_MODE=invite
GLOBAL_DAILY_SIGNUP_LIMIT=50
GLOBAL_WEEKLY_TOKEN_BUDGET=50000000
# Cost-quota rollout: shadow retains token enforcement while dual-recording USD;
# enforce makes USD balances and the UTC monthly platform cap authoritative.
COST_QUOTA_ENFORCEMENT=shadow
GLOBAL_MONTHLY_COST_QUOTA_MICROS=500000000
OPEN_SIGNUP_SHARED_KEYS=false
OPEN_SIGNUP_WEEKLY_TOKEN_BUDGET=250000
OPEN_SIGNUP_MAX_ACTIVE_JOBS=100
OPEN_SIGNUP_MAX_CONCURRENT_RUNS=1
