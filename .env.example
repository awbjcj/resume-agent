# Copy to .env and fill in. .env is git-ignored.

# Required: powers discover, tailor, and cover-letter (Claude).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: enriches `profile build` from your GitHub repos.
GITHUB_TOKEN=

# Optional: Adzuna API credentials for the Adzuna connector used by `pull`.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: burner LinkedIn account used by `scrape` (see design spec §5.2).
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
LINKEDIN_USER_DATA_DIR=.linkedin_profile

# Gmail (`sync-status`) authenticates via config/gmail_credentials.json — no key here.

DB_URL=sqlite:///data/resume_agent.db
