# Which job-source connectors `resume-agent pull` runs, and their parameters.
# Copy to config/connectors.yaml and edit. Secrets (Adzuna keys) go in .env.

greenhouse:
  enabled: true
  boards:
    - token: stripe
      company: Stripe
    - token: airbnb
      company: Airbnb

# Lever boards. token = the jobs.lever.co/<token> slug.
lever:
  enabled: true
  boards:
    - token: palantir
      company: Palantir

# Ashby boards. token = the jobs.ashbyhq.com/<token> slug.
ashby:
  enabled: true
  boards:
    - token: openai
      company: OpenAI

adzuna:
  enabled: true
  country: us

remoteok:
  enabled: true

linkedin:
  enabled: false

# URL-addressed native ATS connectors. Add Source writes recognized URLs into
# the matching section and never into the generic companies compatibility list.
#
# Supported backends:
#   Workday     — <tenant>.<dc>.myworkdayjobs.com/<site>  (uses CXS JSON API)
#   Tesla       — www.tesla.com/careers  (bespoke JSON portal)
#   Google      — careers.google.com/...  (bespoke JSON API)
#   SmartRecruiters — jobs.smartrecruiters.com/<company>/...
#   Workable     — apply.workable.com/<account>/... or <account>.workable.com
#   Recruitee    — <account>.recruitee.com
#   Personio     — <account>.jobs.personio.com or .de
#   Breezy       — <account>.breezy.hr
#   JazzHR       — <account>.applytojob.com
#   BambooHR     — <account>.bamboohr.com/careers
#
# When a URL does not directly reveal the ATS, the connector fetches the page
# and scans it for embedded Greenhouse / Lever / Ashby / Workday markers.
#
# These are "canonical" sources — when they re-find a job
# already ingested from an aggregator (Adzuna, RemoteOK, LinkedIn), the stored
# URL and JD text are upgraded in place. User progress is never reset.
workday:
  enabled: false
  boards:
    - url: https://generalmotors.wd5.myworkdayjobs.com/Careers_GM
      company: General Motors

tesla:
  enabled: false
  boards:
    - url: https://www.tesla.com/careers
      company: Tesla

google:
  enabled: false
  boards:
    - url: https://careers.google.com/jobs/results/
      company: Google

smartrecruiters: {enabled: false, boards: []}
workable: {enabled: false, boards: []}
recruitee: {enabled: false, boards: []}
personio: {enabled: false, boards: []}
breezy: {enabled: false, boards: []}
jazzhr: {enabled: false, boards: []}
bamboohr: {enabled: false, boards: []}

# Backward-compatible storage for older configurations. New recognized sources
# are not added here.
companies: {enabled: false, urls: []}

# Opt-in browser scraper for company-owned boards with no supported ATS.
# It opens an isolated visible browser, learns one selector recipe per host,
# and caches recipes under data/scraper_recipes/. Always set label so jobs
# carry a stable company name.
scrape:
  enabled: false
  targets:
    - url: https://careers.example.com/jobs
      enabled: true
      label: Example Co
