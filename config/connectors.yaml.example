# Which job-source connectors `resume-agent pull` runs, and their parameters.
# Copy to config/connectors.yaml and edit. Secrets (Adzuna keys) go in .env.

greenhouse:
  enabled: true
  boards:
    - token: stripe
      company: Stripe
    - token: airbnb
      company: Airbnb

# Lever boards. token = the jobs.lever.co/<token> slug.
lever:
  enabled: true
  boards:
    - token: palantir
      company: Palantir

adzuna:
  enabled: true
  country: us

remoteok:
  enabled: true

linkedin:
  enabled: false

# Company careers pages by URL. The connector auto-detects the ATS
# (Greenhouse / Lever / Ashby) and pulls all current openings. A direct
# board URL works too; Workday is recognized but not yet fetched.
companies:
  enabled: false
  urls:
    - https://jobs.ashbyhq.com/someorg
