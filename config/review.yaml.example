# Fast review roster (default): fact-check gate + one merged advisory call.
# For the full multi-round panel use --deep / review_deep.yaml.
# Each reviewer's `model_tier` (cheap | mid | premium) resolves to the matching
# CHEAP_MODEL / MID_MODEL / PREMIUM_MODEL in .env, so a tier inherits whatever
# LLM provider that model id names (bare = Anthropic; openai:/gemini:/deepseek:).
max_rounds: 2
early_stop_on_regression: true
score_threshold: 85
merged_advisory: true
evidence_portfolio_enabled: false
tailor_tier: mid
reviser_tier: mid
style_guide_path: config/style_guide.md
reviewers:
  - name: fact-check
    gate: true            # blocking: any unsupported claim fails the round
    weight: 0
    model_tier: premium
  - name: ats-keyword
    gate: false
    weight: 1
    model_tier: mid
    score_bands: true
  - name: recruiter
    gate: false
    weight: 1
    model_tier: mid
    score_bands: true
  - name: hiring-manager
    gate: false
    weight: 1
    model_tier: mid
    score_bands: true
  - name: concision
    gate: false
    weight: 1
    model_tier: mid
    score_bands: true

# Optional two-page evidence budget handed to the tailor and surfaced to advisory
# reviewers. Omit the block to accept these defaults.
#
# Each owner's floor is clamped to its source-bullet supply before it reaches a
# writer, so the plan never asks for invented evidence. The skill numbers are a TARGET:
# the skills section renders one comma-joined line per category, so ~40 entries
# cost about five lines, and trimming it saves almost no space while losing
# keyword coverage. Raise target_skills for a broader skills section.
length_budget:
  page_target: 2
  max_experiences: 5
  max_projects: 4
  max_evidence_owners: 8
  min_bullets_per_role: 5
  max_bullets_per_role: 7
  min_bullets_per_project: 4
  max_bullets_per_project: 6
  target_total_bullets: 40
  min_aspects_per_owner: 3
  target_skills: 40
  max_skills_per_category: 12
